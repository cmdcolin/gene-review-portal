  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gene-review-portal": "./bin/make-portal.mjs"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "@jbrowse/capture": "link:../jbrowse-components/products/jbrowse-capture"
  }
}
