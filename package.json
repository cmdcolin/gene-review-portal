  "description": "Turn a gene prediction, a reference annotation and a genome into a static review portal: the models that disagree, each with a JBrowse capture and a link back into the app",
  "keywords": [
    "genomics",
    "gene-prediction",
    "annotation",
    "jbrowse",
    "gff3"
  ],
  "repository": {
    "type": "git",
