{
  "name": "gene-review-portal",
  "version": "0.1.0",
  "description": "Turn a gene prediction, a reference annotation and a genome into a static review portal: the models that disagree, each with a JBrowse capture and a link back into the app",
  "keywords": [
    "genomics",
    "gene-prediction",
    "annotation",
    "jbrowse",
    "gff3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cmdcolin/gene-review-portal.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gene-review-portal": "./bin/make-portal.mjs"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@jbrowse/capture": "5.0.0-beta.8",
    "esbuild": "^0.28.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "puppeteer": "^25.10.0",
    "tsrs": "0.23.0-ts7.1.0-beta"
  }
}
